#!/usr/bin/env python3
"""Show remaining quota for every configured model provider.

Reads live usage from `openclaw status --usage` and the model providers named
in openclaw.json. Prints each remaining window, balance, or budget, then a
link to add tokens. Providers that do not report a quota still get a link.

OpenClaw only reports usage for providers whose plugin declares a usage hook
(anthropic, openai, openrouter, xai, minimax, github-copilot, clawrouter).
DeepInfra, Groq and Perplexity have no hook, so this script calls their APIs
directly with the keys in the environment. See PROBES.

  quotas
  quotas --json
  quotas --agent work
  quotas --groq-probe      spend one token to read Groq rate limits
  quotas --no-probe        skip the direct provider API calls

Env:
  OPENCLAW_STATE_DIR     config directory (default /data/.openclaw)
  OPENCLAW_ENTRY         path to OpenClaw entry.js, when the CLI is not on PATH
  OPENCLAW_NODE          node binary used with OPENCLAW_ENTRY (default node)
  DEEPINFRA_API_KEY      balance, month spend, spend limit, scoped credits
  GROQ_API_KEY           request/token rate limits
  GROQ_QUOTA_MODEL       model the --groq-probe request names (default gpt-oss-20b)
  PERPLEXITY_API_KEY     makes Perplexity show up; carries no quota itself
  PERPLEXITY_ANALYTICS_API_KEY
                         org analytics key (Enterprise + Computer), for credits
                         consumed. Perplexity exposes no API credit balance.
"""

from __future__ import annotations

import concurrent.futures
import json
import os
import re
import shutil
import subprocess
import sys
from typing import Callable
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path

DEFAULT_TIMEOUT_SECONDS = 60
DEFAULT_PROBE_TIMEOUT_SECONDS = 10
MAX_PROBE_RESPONSE_BYTES = 1 << 20

