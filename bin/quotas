# Providers OpenClaw reports no usage for. Each probe reads its own key from
# the environment and returns the same row shapes a usage snapshot would, so
# the report renders them beside the providers the CLI does cover.
#   discovery: any of these keys makes the provider appear in the report
#   credential: the key the probe authenticates with
#   needsKey: skip the request and name the variable when the key is missing.
#     Perplexity probes without one so it can explain the console-only balance.
PROBES: dict[str, dict] = {
    "deepinfra": {
        "discovery": ["DEEPINFRA_API_KEY"],
        "credential": ["DEEPINFRA_API_KEY"],
        "needsKey": True,
    },
    "groq": {
        "discovery": ["GROQ_API_KEY"],
        "credential": ["GROQ_API_KEY"],
        "needsKey": True,
    },
    "perplexity": {
        "discovery": ["PERPLEXITY_API_KEY", "PERPLEXITY_ANALYTICS_API_KEY"],
        "credential": ["PERPLEXITY_ANALYTICS_API_KEY"],
        "needsKey": False,
    },
}

DEEPINFRA_ME_URL = "https://api.deepinfra.com/v1/me"
DEEPINFRA_USAGE_URL = "https://api.deepinfra.com/payment/usage?from=current"
GROQ_MODELS_URL = "https://api.groq.com/openai/v1/models"
GROQ_CHAT_URL = "https://api.groq.com/openai/v1/chat/completions"
DEFAULT_GROQ_QUOTA_MODEL = "openai/gpt-oss-20b"
PERPLEXITY_ANALYTICS_URL = "https://api.perplexity.ai/v1/analytics/computer/usage"
PERPLEXITY_ANALYTICS_DAYS = 7

# x-ratelimit-reset-* arrives as a Go duration such as "2m59.56s" or "7.66s".
DURATION_PART = re.compile(r"(\d+(?:\.\d+)?)(ms|h|m|s)")
DURATION_SCALE = {"ms": 0.001, "s": 1.0, "m": 60.0, "h": 3600.0}


def env_value(names: list[str]) -> str:
    for name in names:
        value = os.environ.get(name, "").strip()
        if value:
            return value
    return ""


def number(value: object) -> float | None:
    if isinstance(value, bool) or value is None:
        return None
    try:
        parsed = float(value)
    except (TypeError, ValueError):
        return None
    return parsed if parsed == parsed and abs(parsed) != float("inf") else None


def cents(value: object) -> float | None:
    """DeepInfra keeps every money field in cents, Stripe style."""
    amount = number(value)
    return None if amount is None else amount / 100


def money(amount: float) -> str:
    return f"${amount:,.2f}"


def count(amount: float) -> str:
    return f"{amount:,.0f}"


def parse_duration(value: object) -> float | None:
    if not isinstance(value, str) or not value.strip():
        return None
    text = value.strip()
    total = 0.0
    matched = False
    for amount, unit in DURATION_PART.findall(text):
        total += float(amount) * DURATION_SCALE[unit]
        matched = True
    if matched:
        return total
    plain = number(text)
    return plain if plain is not None and plain >= 0 else None


def fetch_json(
    url: str,
    token: str,
    timeout: float,
    *,
    method: str = "GET",
    body: dict | None = None,
) -> dict:
    """One JSON request. Never raises; failures come back in ["error"]."""
    headers = {"Accept": "application/json", "User-Agent": "quotas"}
    if token:
        headers["Authorization"] = f"Bearer {token}"
    payload = None
    if body is not None:
        payload = json.dumps(body).encode("utf-8")
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(url, data=payload, headers=headers, method=method)
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return read_response(response.status, response.headers, response.read(MAX_PROBE_RESPONSE_BYTES + 1))
    except urllib.error.HTTPError as exc:
        try:
            raw = exc.read(MAX_PROBE_RESPONSE_BYTES + 1)
        except OSError:
            raw = b""
        result = read_response(exc.code, exc.headers, raw)
        result["error"] = result["error"] or http_error(exc.code, result["payload"])
        return result
    except (urllib.error.URLError, OSError, ValueError) as exc:
        reason = getattr(exc, "reason", exc)
        return {"status": 0, "headers": {}, "payload": None, "error": f"unreachable ({reason})"}


def read_response(status: int, raw_headers: object, raw: bytes) -> dict:
    headers = {}
    for key, value in getattr(raw_headers, "items", lambda: [])():
        headers[str(key).lower()] = value
    result = {"status": int(status), "headers": headers, "payload": None, "error": ""}
    if len(raw) > MAX_PROBE_RESPONSE_BYTES:
        result["error"] = "response too large"
        return result
    if not raw.strip():
        return result
    try:
        result["payload"] = json.loads(raw.decode("utf-8", "replace"))
    except (json.JSONDecodeError, UnicodeDecodeError):
        result["error"] = "malformed response"
    return result


def http_error(status: int, payload: object) -> str:
    detail = ""
    if isinstance(payload, dict):
        error = payload.get("error")
        if isinstance(error, dict):
            detail = str(error.get("message") or error.get("type") or "")
        elif isinstance(error, str):
            detail = error
        if not detail:
            raw_detail = payload.get("detail") or payload.get("message")
            if isinstance(raw_detail, str):
                detail = raw_detail
    detail = detail.strip()
    if status in {401, 403}:
        return detail or f"key rejected ({status})"
    if status == 404:
        return detail or "not available for this account (404)"
    return f"{detail} ({status})" if detail else f"HTTP {status}"


def ratelimit_windows(headers: dict, now: datetime, group: str = "") -> list[dict]:
    """Turn x-ratelimit-* headers into remaining-quota rows."""
    rows = []
    for kind, label, unit in (
        ("requests", "Requests (RPD)", "requests"),
        ("tokens", "Tokens (TPM)", "tokens"),
    ):
        limit = number(headers.get(f"x-ratelimit-limit-{kind}"))
        remaining = number(headers.get(f"x-ratelimit-remaining-{kind}"))
        if limit is None or remaining is None or limit <= 0:
            continue
        remaining = max(0.0, min(limit, remaining))
        reset_seconds = parse_duration(headers.get(f"x-ratelimit-reset-{kind}"))
        when = now + timedelta(seconds=reset_seconds) if reset_seconds is not None else None
        rows.append(
            {
                "label": f"{group} {label}".strip(),
                "remainingPercent": clamp_percent(remaining / limit * 100) or 0.0,
                "usedPercent": clamp_percent((limit - remaining) / limit * 100),
                "remainingText": f"{count(remaining)} of {count(limit)} {unit} left",
                "resets": format_reset(when, now),
                "resetsAt": when.isoformat() if when else None,
            }
        )
    return rows


def probe_deepinfra(token: str, timeout: float, options: dict) -> dict:
    me = fetch_json(DEEPINFRA_ME_URL, token, timeout)
    if me["error"]:
        return {"error": me["error"]}
    payload = me["payload"] if isinstance(me["payload"], dict) else {}
    checklist = payload.get("checklist")
    if not isinstance(checklist, dict):
        return {"error": "no billing data in /v1/me"}

    now = datetime.now(timezone.utc)
    windows: list[dict] = []
    billing: list[dict] = []

    # A negative Stripe balance is money already paid in; positive is owed.
    balance = cents(checklist.get("stripe_balance"))
    if balance is not None:
        available = -balance
        if available >= 0:
            billing.append({"label": "Prepaid balance", "text": f"{money(available)} left"})
        else:
            billing.append({"label": "Balance due", "text": f"{money(-available)} owed"})

    recent = cents(checklist.get("recent"))
    if recent is not None:
        billing.append({"label": "Since last invoice", "text": f"{money(recent)} spent"})

    limit = cents(checklist.get("limit"))
    if limit is not None and limit > 0:
        used = recent if recent is not None else 0.0
        windows.append(
            {
                "label": "Spending limit",
                "remainingPercent": clamp_percent((limit - used) / limit * 100) or 0.0,
                "usedPercent": clamp_percent(used / limit * 100),
                "remainingText": f"{money(max(0.0, limit - used))} of {money(limit)} left",
                "resets": None,
                "resetsAt": None,
            }
        )

    for credit in checklist.get("scoped_credits") or []:
        if not isinstance(credit, dict) or credit.get("expired") is True:
            continue
        granted = cents(credit.get("granted_cents"))
        left = cents(credit.get("remaining_cents"))
        if granted is None or left is None or granted <= 0:
            continue
        name = str(credit.get("name") or "credit").strip() or "credit"
        expires = parse_reset(credit.get("expires_ts"))
        windows.append(
            {
                "label": f"{name} credit",
                "remainingPercent": clamp_percent(left / granted * 100) or 0.0,
                "usedPercent": clamp_percent((granted - left) / granted * 100),
                "remainingText": f"{money(left)} of {money(granted)} left",
                "resets": format_reset(expires, now),
                "resetVerb": "expires",
                "resetsAt": expires.isoformat() if expires else None,
            }
        )

    month = fetch_json(DEEPINFRA_USAGE_URL, token, timeout)
    if not month["error"] and isinstance(month["payload"], dict):
        months = month["payload"].get("months")
        if isinstance(months, list) and months:
            latest = months[-1] if isinstance(months[-1], dict) else {}
            spent = cents(latest.get("total_cost"))
            if spent is not None:
                period = str(latest.get("period") or "").strip()
                label = f"Spend ({period})" if period else "Spend this month"
                billing.append({"label": label, "text": f"{money(spent)} spent"})

    result = {"windows": windows, "billing": billing}
    if checklist.get("suspended") is True:
        reason = str(checklist.get("suspend_reason") or "").strip()
        result["error"] = f"account suspended ({reason})" if reason else "account suspended"
    return result


def probe_groq(token: str, timeout: float, options: dict) -> dict:
    now = datetime.now(timezone.utc)
    # /models is free. Groq documents the headers on API responses generally,
    # so read them here before considering a billable request.
    listing = fetch_json(GROQ_MODELS_URL, token, timeout)
    if listing["status"] in {401, 403}:
        return {"error": listing["error"]}
    windows = ratelimit_windows(listing["headers"], now)
    if windows:
        return {"windows": windows}
    if not options.get("groq_probe"):
        return {"note": "rate limits need an inference request; rerun with --groq-probe"}

    model = os.environ.get("GROQ_QUOTA_MODEL", "").strip() or DEFAULT_GROQ_QUOTA_MODEL
    chat = fetch_json(
        GROQ_CHAT_URL,
        token,
        timeout,
        method="POST",
        body={
            "model": model,
            "messages": [{"role": "user", "content": "1"}],
            "max_tokens": 1,
            "temperature": 0,
        },
    )
    windows = ratelimit_windows(chat["headers"], now)
    if windows:
        # Groq scopes RPD and TPM per model, so name the one that was asked.
        return {"windows": windows, "plan": model}
    retry_after = parse_duration(chat["headers"].get("retry-after"))
    if chat["status"] == 429:
        when = now + timedelta(seconds=retry_after) if retry_after is not None else None
        resets = format_reset(when, now) if when else "soon"
        return {"error": f"rate limited, clears {resets}"}
    return {"error": chat["error"] or "no rate-limit headers returned"}


def probe_perplexity(token: str, timeout: float, options: dict) -> dict:
    # The API credit balance is console-only. The analytics API is a different
    # (Enterprise, org-scoped) key and reports Computer credits consumed.
    if not token:
        return {"note": "balance is console-only; see PERPLEXITY_ANALYTICS_API_KEY"}
    now = datetime.now(timezone.utc)
    start = int((now - timedelta(days=PERPLEXITY_ANALYTICS_DAYS)).timestamp())
    query = urllib.parse.urlencode(
        {
            "dataset": "credit_usage",
            "start_time": start,
            "bucket_width": "1d",
            "limit": PERPLEXITY_ANALYTICS_DAYS,
        }
    )
    response = fetch_json(f"{PERPLEXITY_ANALYTICS_URL}?{query}", token, timeout)
    if response["status"] == 404:
        return {"error": "analytics API not enabled for this organization"}
    if response["error"]:
        return {"error": response["error"]}
    payload = response["payload"] if isinstance(response["payload"], dict) else {}
    buckets = payload.get("data")
    if not isinstance(buckets, list):
        return {"error": "malformed analytics response"}
    total = 0.0
    for bucket in buckets:
        if isinstance(bucket, dict):
            total += number(bucket.get("count")) or 0.0
    # Consumption only: there is no limit to divide by, so this is not a window.
    return {
        "billing": [
            {
                "label": "Computer credits",
                "text": f"{count(total)} used (last {PERPLEXITY_ANALYTICS_DAYS}d)",
            }
        ]
    }


PROBE_RUNNERS: dict[str, Callable[[str, float, dict], dict]] = {
    "deepinfra": probe_deepinfra,
    "groq": probe_groq,
    "perplexity": probe_perplexity,
}


def probe_providers(config: dict) -> list[str]:
    """Probe anything configured in openclaw.json or keyed in the environment."""
    configured = set(configured_providers(config))
    wanted = []
    for provider_id, keys in PROBES.items():
        if provider_id in configured or env_value(keys["discovery"]):
            wanted.append(provider_id)
    return wanted


def run_probes(providers: list[str], timeout: float, options: dict) -> dict[str, dict]:
    results: dict[str, dict] = {}
    tasks = []
    for provider_id in providers:
        spec = PROBES[provider_id]
        token = env_value(spec["credential"])
        if not token and spec["needsKey"]:
            results[provider_id] = {"note": f"set {spec['credential'][0]} to read quota"}
            continue
        tasks.append((provider_id, token))
    if not tasks:
        return results
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(tasks)) as pool:
        futures = {
            pool.submit(PROBE_RUNNERS[provider_id], token, timeout, options): provider_id
            for provider_id, token in tasks
        }
        for future in concurrent.futures.as_completed(futures):
            provider_id = futures[future]
            try:
                results[provider_id] = future.result()
            except Exception as exc:  # a probe must never sink the report
                results[provider_id] = {"error": f"probe failed ({exc})"}
    return results


def state_dir() -> Path:
    raw = os.environ.get("OPENCLAW_STATE_DIR", "").strip()
    return Path(raw or "/data/.openclaw")


def config_path() -> Path:
    return state_dir() / "openclaw.json"


def openclaw_command(*args: str) -> list[str]:
    entry = os.environ.get("OPENCLAW_ENTRY", "").strip()
    node = os.environ.get("OPENCLAW_NODE", "").strip() or "node"
    if entry:
        return [node, entry, *args]
    return ["openclaw", *args]


def drop_privileges() -> None:
    """Re-run as the openclaw user when the Railway console is root.

    gosu starts this script again under that user. os.geteuid() is no longer 0
    there, so the second process does not launch itself again.
    """
    if not hasattr(os, "geteuid") or os.geteuid() != 0:
        return
    if not shutil.which("gosu") or not Path("/home/openclaw").is_dir():
        return
    env = os.environ.copy()
    env["HOME"] = "/home/openclaw"
    env["USER"] = "openclaw"
    env["LOGNAME"] = "openclaw"
    os.execvpe("gosu", ["gosu", "openclaw", sys.executable, *sys.argv], env)


def canonical(provider_id: str) -> str:
    key = provider_id.strip().lower()
    return ALIASES.get(key, key)


def provider_info(provider_id: str) -> tuple[str, list[tuple[str, str]]]:
    key = canonical(provider_id)
    if key in PROVIDERS:
        return PROVIDERS[key]
    label = provider_id.strip().replace("_", " ").replace("-", " ")
    label = " ".join(part.capitalize() for part in label.split()) or provider_id
    return label, []


def load_config() -> dict:
    path = config_path()
    if not path.is_file():
        return {}
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}
    return value if isinstance(value, dict) else {}


def add_model_ref(found: set[str], ref: object) -> None:
    if not isinstance(ref, str) or "/" not in ref:
        return
    provider = ref.split("/", 1)[0].strip()
    if provider:
        found.add(provider)


def configured_providers(config: dict) -> list[str]:
    found: set[str] = set()
    models = config.get("models")
    if isinstance(models, dict):
        providers = models.get("providers")
        if isinstance(providers, dict):
            for key in providers:
                if isinstance(key, str) and key.strip():
                    found.add(key.strip())

    def walk(node: object, key: str | None = None) -> None:
        if key == "models" and isinstance(node, dict):
            for model_id in node:
                add_model_ref(found, model_id)
        if key in {"model", "primary", "imageModel", "utilityModel"} and isinstance(node, str):
            add_model_ref(found, node)
        if key == "fallbacks" and isinstance(node, list):
            for item in node:
                add_model_ref(found, item)
                if isinstance(item, dict):
                    walk(item, key)
        if isinstance(node, dict):
            for child_key, child in node.items():
                walk(child, child_key)
        elif isinstance(node, list) and key != "fallbacks":
            for item in node:
                walk(item, key)

    walk(config.get("agents"))
    return sorted(found, key=lambda item: item.lower())


def provider_base_url(config: dict, provider_id: str) -> str:
    models = config.get("models")
    if not isinstance(models, dict):
        return ""
    providers = models.get("providers")
    if not isinstance(providers, dict):
        return ""
    entry = providers.get(provider_id)
    if not isinstance(entry, dict):
        return ""
    base = entry.get("baseUrl") or entry.get("baseURL") or ""
    return base if isinstance(base, str) else ""


def links_for(provider_id: str, base_url: str) -> list[dict[str, str]]:
    key = canonical(provider_id)
    host_key = ""
    lowered = base_url.lower()
    for host, mapped in HOSTS.items():
        if host in lowered:
            host_key = mapped
            break
    chosen = host_key or key
    _name, links = provider_info(chosen if chosen in PROVIDERS or chosen in ALIASES else key)
    if chosen in PROVIDERS:
        links = PROVIDERS[chosen][1]
    elif key in PROVIDERS:
        links = PROVIDERS[key][1]
    return [{"label": label, "url": url} for label, url in links]


def clamp_percent(value: object) -> float | None:
    try:
        number = float(value)
    except (TypeError, ValueError):
        return None
    return max(0.0, min(100.0, number))


def remaining_percent(window: dict) -> float | None:
    if "remainingPercent" in window:
        return clamp_percent(window.get("remainingPercent"))
    if "usedPercent" in window:
        used = clamp_percent(window.get("usedPercent"))
        if used is None:
            return None
        return clamp_percent(100 - used)
    return None


def parse_reset(value: object) -> datetime | None:
    if isinstance(value, (int, float)) and value > 0:
        seconds = float(value) / 1000 if value > 10_000_000_000 else float(value)
        try:
            return datetime.fromtimestamp(seconds, timezone.utc)
        except (OverflowError, OSError, ValueError):
            return None
    if isinstance(value, str) and value.strip():
        text = value.strip().replace("Z", "+00:00")
        try:
            parsed = datetime.fromisoformat(text)
        except ValueError:
            return None
        if parsed.tzinfo is None:
            parsed = parsed.replace(tzinfo=timezone.utc)
        return parsed
    return None


def format_reset(when: datetime | None, now: datetime) -> str | None:
    if when is None:
        return None
    diff = int((when - now).total_seconds())
    if diff <= 0:
        return "now"
    if diff < 60:
        return f"in {diff}s"
    minutes = diff // 60
    if minutes < 60:
        return f"in {minutes}m"
    hours, mins = divmod(minutes, 60)
    if hours < 24:
        return f"in {hours}h {mins}m" if mins else f"in {hours}h"
    days, hours = divmod(hours, 24)
    if days < 7:
        return f"in {days}d {hours}h"
    stamp = when.astimezone(timezone.utc)
    return f"{stamp.strftime('%b')} {stamp.day}"


def format_percent(value: float) -> str:
    if abs(value - round(value)) < 0.05:
        return f"{round(value):.0f}%"
    return f"{value:.1f}%"


def format_amount(amount: object, unit: object) -> str | None:
    try:
        number = float(amount)
    except (TypeError, ValueError):
        return None
    unit_text = unit.strip() if isinstance(unit, str) else ""
    if unit_text.upper() == "USD":
        return f"${number:,.2f}"
    rendered = f"{number:,.2f}"
    return f"{rendered} {unit_text}".strip() if unit_text else rendered


def window_row(window: dict, now: datetime) -> dict | None:
    if not isinstance(window, dict):
        return None
    label = window.get("label") or window.get("name") or "quota"
    group = window.get("groupLabel")
    if isinstance(group, str) and group.strip() and group.strip().lower() not in str(label).lower():
        label = f"{group.strip()} {label}"
    remaining = remaining_percent(window)
    if remaining is None:
        return None
    used = clamp_percent(window.get("usedPercent"))
    reset = parse_reset(window.get("resetAt"))
    return {
        "label": str(label),
        "remainingPercent": remaining,
        "usedPercent": used,
        "resets": format_reset(reset, now),
        "resetsAt": reset.isoformat() if reset else None,
    }


def billing_row(entry: dict) -> dict | None:
    if not isinstance(entry, dict):
        return None
    kind = entry.get("type")
    unit = entry.get("unit")
    label = entry.get("label") if isinstance(entry.get("label"), str) else ""
    period = entry.get("period") if isinstance(entry.get("period"), str) else ""
    if kind == "balance":
        amount = format_amount(entry.get("amount"), unit)
        if amount is None:
            return None
        text = f"{amount} left"
    elif kind == "budget":
        used = format_amount(entry.get("used"), unit)
        limit = format_amount(entry.get("limit"), unit)
        if used is None or limit is None:
            return None
        try:
            left = float(entry.get("limit")) - float(entry.get("used"))
        except (TypeError, ValueError):
            left = None
        left_text = format_amount(left, unit) if left is not None else None
        text = f"{left_text} left of {limit}" if left_text else f"{used} used of {limit}"
    elif kind == "spend":
        amount = format_amount(entry.get("amount"), unit)
        if amount is None:
            return None
        text = f"{amount} spent"
    else:
        return None
    if period:
        text = f"{text} ({period})"
    return {"label": label or kind, "text": text}


def snapshot_rows(snapshots: list) -> dict[str, dict]:
    rows: dict[str, dict] = {}
    now = datetime.now(timezone.utc)
    for snapshot in snapshots:
        if not isinstance(snapshot, dict):
            continue
        provider_id = snapshot.get("provider") or snapshot.get("id") or ""
        if not isinstance(provider_id, str) or not provider_id.strip():
            continue
        provider_id = provider_id.strip()
        name = snapshot.get("displayName")
        if not isinstance(name, str) or not name.strip():
            name = provider_info(provider_id)[0]
        windows = [
            row
            for row in (
                window_row(item, now)
                for item in snapshot.get("windows") or []
                if isinstance(item, dict)
            )
            if row
        ]
        billing = [
            row
            for row in (billing_row(item) for item in snapshot.get("billing") or [])
            if row
        ]
        summary = snapshot.get("summary") if isinstance(snapshot.get("summary"), str) else ""
        plan = snapshot.get("plan") if isinstance(snapshot.get("plan"), str) else ""
        error = snapshot.get("error") if isinstance(snapshot.get("error"), str) else ""
        rows[provider_id] = {
            "id": provider_id,
            "name": name.strip(),
            "plan": plan.strip(),
            "summary": summary.strip(),
            "error": error.strip(),
            "windows": windows,
            "billing": billing,
        }
    return rows


def extract_json(text: str) -> dict:
    raw = text.strip()
    if not raw:
        raise ValueError("openclaw returned no JSON")
    try:
        value = json.loads(raw)
    except json.JSONDecodeError:
        start = raw.find("{")
        end = raw.rfind("}")
        if start < 0 or end <= start:
            raise ValueError("openclaw returned no JSON") from None
        value = json.loads(raw[start : end + 1])
    if not isinstance(value, dict):
        raise ValueError("openclaw JSON was not an object")
    return value


def usage_from_payload(payload: dict) -> tuple[list, int | None, bool]:
    usage = payload.get("usage")
    if isinstance(usage, dict) and isinstance(usage.get("providers"), list):
        updated = usage.get("updatedAt")
        return (
            usage["providers"],
            updated if isinstance(updated, int) else None,
            bool(usage.get("refreshing")),
        )
    return [], None, False


def load_usage(agent: str | None, timeout_seconds: float) -> tuple[list, int | None, bool]:
    timeout_ms = max(1, int(timeout_seconds * 1000))
    args = ["status", "--usage", "--json", "--timeout", str(timeout_ms)]
    if agent:
        args.extend(["--agent", agent])
    try:
        proc = subprocess.run(
            openclaw_command(*args),
            capture_output=True,
            text=True,
            timeout=timeout_seconds + 15,
        )
    except FileNotFoundError as exc:
        raise RuntimeError("openclaw is not available") from exc
    except subprocess.TimeoutExpired as exc:
        raise RuntimeError("openclaw status --usage timed out") from exc
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout).strip().splitlines()
        message = detail[-1] if detail else f"exit {proc.returncode}"
        raise RuntimeError(message)
    payload = extract_json(proc.stdout)
    return usage_from_payload(payload)


def build_report(
    config: dict,
    snapshots: list,
    usage_error: str | None,
    probes: dict[str, dict] | None = None,
) -> dict:
    live = snapshot_rows(snapshots)
    probes = probes or {}
    ordered: list[str] = list(live)
    for provider_id in configured_providers(config):
        if provider_id not in live:
            ordered.append(provider_id)
    for provider_id in probes:
        if provider_id not in ordered:
            ordered.append(provider_id)
    providers = []
    for provider_id in ordered:
        row = live.get(provider_id, {})
        name, _links = provider_info(provider_id)
        base_url = provider_base_url(config, provider_id)
        key = canonical(provider_id)
        probe = probes.get(key, {})
        windows = [*(row.get("windows") or []), *(probe.get("windows") or [])]
        billing = [*(row.get("billing") or []), *(probe.get("billing") or [])]
        note = ""
        error = row.get("error") or ""
        if not windows and not billing:
            # A probe speaks for its own provider, so its result wins over the
            # generic "openclaw status --usage" failure.
            if probe.get("error"):
                error = probe["error"]
            elif probe.get("note"):
                note = probe["note"]
            elif key in LOCAL:
                note = "runs locally"
            elif error:
                pass
            elif usage_error:
                error = usage_error
            else:
                note = "not reported"
        providers.append(
            {
                "id": provider_id,
                "name": row.get("name") or name,
                "plan": row.get("plan") or probe.get("plan") or "",
                "summary": row.get("summary") or "",
                "error": error,
                "note": note,
                "windows": windows,
                "billing": billing,
                "addTokens": links_for(provider_id, base_url),
            }
        )
    return {"providers": providers}


def format_report(report: dict) -> str:
    providers = report.get("providers") or []
    if not providers:
        return "No model providers are configured, and no usage was reported."
    blocks = ["Quotas", ""]
    for entry in providers:
        title = entry["name"]
        if entry.get("plan"):
            title = f"{title} — {entry['plan']}"
        blocks.append(title)
        lines: list[tuple[str, str]] = []
        for window in entry.get("windows") or []:
            detail = f"{format_percent(window['remainingPercent'])} left"
            if window.get("remainingText"):
                detail = f"{window['remainingText']}  {format_percent(window['remainingPercent'])}"
            if window.get("resets"):
                detail = f"{detail}  {window.get('resetVerb') or 'resets'} {window['resets']}"
            lines.append((str(window["label"]), detail))
        for item in entry.get("billing") or []:
            lines.append((item.get("label") or "balance", item["text"]))
        if not lines and entry.get("summary"):
            lines.append(("quota", entry["summary"]))
        if entry.get("error"):
            lines.append(("quota", f"unavailable ({entry['error']})"))
        elif entry.get("note") and not lines:
            lines.append(("quota", entry["note"]))
        for link in entry.get("addTokens") or []:
            lines.append((link["label"], link["url"]))
        if not lines:
            lines.append(("quota", "not reported"))
        width = max(len(label) for label, _detail in lines)
        for label, detail in lines:
            blocks.append(f"  {label.ljust(width)}  {detail}")
        blocks.append("")
    return "\n".join(blocks).rstrip() + "\n"


USAGE = (
    "usage: quotas [--json] [--agent ID] [--timeout SECONDS]\n"
    "              [--probe-timeout SECONDS] [--no-probe] [--groq-probe]"
)


def main(argv: list[str]) -> int:
    agent = None
    as_json = False
    timeout = float(DEFAULT_TIMEOUT_SECONDS)
    probe_timeout = float(DEFAULT_PROBE_TIMEOUT_SECONDS)
    probe = True
    options = {"groq_probe": False}
    args = argv[1:]
    index = 0
    while index < len(args):
        arg = args[index]
        if arg == "--json":
            as_json = True
        elif arg == "--no-probe":
            probe = False
        elif arg == "--groq-probe":
            options["groq_probe"] = True
        elif arg == "--agent":
            if index + 1 >= len(args):
                print(USAGE, file=sys.stderr)
                return 2
            index += 1
            agent = args[index]
        elif arg in {"--timeout", "--probe-timeout"}:
            if index + 1 >= len(args):
                print(USAGE, file=sys.stderr)
                return 2
            index += 1
            try:
                seconds = float(args[index])
            except ValueError:
                print(f"{arg} must be a number of seconds", file=sys.stderr)
                return 2
            if seconds <= 0:
                print(f"{arg} must be greater than 0", file=sys.stderr)
                return 2
            if arg == "--timeout":
                timeout = seconds
            else:
                probe_timeout = seconds
        elif arg in {"-h", "--help"}:
            print(__doc__.strip())
            return 0
        else:
            print(f"unknown argument: {arg}", file=sys.stderr)
            return 2
        index += 1

    drop_privileges()
    config = load_config()
    usage_error = None
    snapshots: list = []
    try:
        snapshots, _updated, refreshing = load_usage(agent, timeout)
        if refreshing and not snapshots:
            usage_error = "usage is still refreshing; run this again in a moment"
    except (OSError, RuntimeError, ValueError, json.JSONDecodeError) as exc:
        usage_error = str(exc)

    probes = run_probes(probe_providers(config), probe_timeout, options) if probe else {}
    report = build_report(config, snapshots, usage_error, probes)
    if not report["providers"]:
        message = usage_error or "No model providers are configured, and no usage was reported."
        print(message, file=sys.stderr)
        return 1
    if as_json:
        print(json.dumps(report, indent=2, ensure_ascii=False))
    else:
        sys.stdout.write(format_report(report))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
