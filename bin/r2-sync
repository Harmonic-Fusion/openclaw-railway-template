#!/bin/bash
# Two-way sync between the OpenClaw workspace and a Cloudflare R2 bucket
# (rclone bisync), with git snapshots of the workspace for rollback.
#
# Watchdog mode: triggers on file changes in the workspace, with a quiet period
# to batch rapid changes, plus a periodic sync so remote-side edits get pulled.
#
# Opt-in: does nothing unless R2_BUCKET is set.
#
# Env:
#   R2_BUCKET             bucket name (required to enable)
#   R2_ACCESS_KEY_ID      R2 API token access key (required)
#   R2_SECRET_ACCESS_KEY  R2 API token secret (required)
#   R2_ACCOUNT_ID         Cloudflare account id (required unless R2_ENDPOINT set)
#   R2_ENDPOINT           override endpoint URL
#   R2_PREFIX             optional key prefix inside the bucket
#   R2_SYNC_INTERVAL      max seconds between syncs (default 120); a sync also
#                         fires as soon as the workspace changes
#   R2_SYNC_DEBOUNCE      quiet period after last file change before syncing (default 5)
#   R2_GIT_REMOTE         optional private git remote URL; snapshots are pushed to it
#   R2_GIT_SNAPSHOTS      enable/disable git snapshots (default true)
#
# Pause: `touch /data/.r2-sync-paused` (remove the file to resume).
# Force a merge on the next cycle: `r2-sync --resync` (newest file wins).
# If a sync is already running, that process does the resync; this one exits.

set -u

usage() {
  cat <<'EOF'
usage: r2-sync [--resync] [-h|--help]

Two-way sync between the OpenClaw workspace and a Cloudflare R2 bucket
(rclone bisync), with git snapshots of the workspace for rollback.

With no arguments, runs until stopped. A sync starts shortly after the
workspace changes, and at least every R2_SYNC_INTERVAL seconds so edits
made on the R2 side are pulled down. Does nothing unless R2_BUCKET is set.

Options:
  --resync    Merge the local workspace and R2 on the next cycle
              (newest file wins). If a sync is already running, that
              process does the resync and this command exits.
  -h, --help  Show this help.

Pause and resume:
  touch /data/.r2-sync-paused
  rm /data/.r2-sync-paused

Environment:
  R2_BUCKET             Bucket name. Required to enable sync.
  R2_ACCESS_KEY_ID      R2 API token access key. Required.
  R2_SECRET_ACCESS_KEY  R2 API token secret. Required.
  R2_ACCOUNT_ID         Cloudflare account id, unless R2_ENDPOINT is set.
  R2_ENDPOINT           Override the R2 endpoint URL.
  R2_PREFIX             Optional key prefix inside the bucket.
  R2_SYNC_INTERVAL      Max seconds between syncs (default 120).
  R2_SYNC_DEBOUNCE      Quiet period after the last file change, in seconds
                        (default 5).
  R2_GIT_SNAPSHOTS      Commit workspace snapshots around each sync
                        (default true).
  R2_GIT_REMOTE         Optional private git remote. Snapshots are pushed to it.
  R2_DATA_DIR           Data directory (default /data).
  OPENCLAW_STATE_DIR    State directory (default $R2_DATA_DIR/.openclaw).
  OPENCLAW_WORKSPACE_DIR
                        Workspace to sync (default $OPENCLAW_STATE_DIR/workspace).

Logs go to stdout and to r2-sync.log in the state directory.
EOF
}

FORCE_RESYNC=0
while [ $# -gt 0 ]; do
  case "$1" in
    --resync) FORCE_RESYNC=1 ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "r2-sync: unknown argument: $1" >&2
      echo "Try 'r2-sync --help' for more information." >&2
      exit 2
      ;;
  esac
  shift
done

if [ -z "${R2_BUCKET:-}" ]; then
  exit 0
fi

DATA_DIR="${R2_DATA_DIR:-/data}"
STATE_DIR="${OPENCLAW_STATE_DIR:-$DATA_DIR/.openclaw}"
WORKSPACE_DIR="${OPENCLAW_WORKSPACE_DIR:-$STATE_DIR/workspace}"
INTERVAL="${R2_SYNC_INTERVAL:-120}"
DEBOUNCE="${R2_SYNC_DEBOUNCE:-5}"
SNAPSHOTS="${R2_GIT_SNAPSHOTS:-true}"
PREFIX="${R2_PREFIX:-}"
PREFIX="${PREFIX#/}"
PREFIX="${PREFIX%/}"
PAUSE_FLAG="$DATA_DIR/.r2-sync-paused"
WORKDIR="$DATA_DIR/.rclone-bisync"
PIDFILE="$WORKDIR/r2-sync.pid"
RESYNC_REQUEST="$WORKDIR/resync-request"
LOG_FILE="$STATE_DIR/r2-sync.log"
FILTERS_FILE="$WORKDIR/filters.txt"

mkdir -p "$STATE_DIR" "$WORKSPACE_DIR" "$WORKDIR"

log() {
  local line
  line="[r2-sync] $(date -u +%FT%TZ) $*"
  echo "$line"
  echo "$line" >> "$LOG_FILE" 2>/dev/null || true
}

# Keep the log from growing without bound (~1MB).
rotate_log() {
  if [ -f "$LOG_FILE" ] && [ "$(wc -c < "$LOG_FILE")" -gt 1048576 ]; then
    tail -n 2000 "$LOG_FILE" > "$LOG_FILE.tmp" && mv "$LOG_FILE.tmp" "$LOG_FILE"
  fi
}

if [ -z "${R2_ACCESS_KEY_ID:-}" ] || [ -z "${R2_SECRET_ACCESS_KEY:-}" ]; then
  log "R2_BUCKET is set but R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY are missing; sync disabled"
  exit 0
fi

ENDPOINT="${R2_ENDPOINT:-}"
if [ -z "$ENDPOINT" ]; then
  if [ -z "${R2_ACCOUNT_ID:-}" ]; then
    log "Set R2_ACCOUNT_ID (or R2_ENDPOINT); sync disabled"
    exit 0
  fi
  ENDPOINT="https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com"
fi

# rclone remote "r2" configured purely from env (no config file).
export RCLONE_CONFIG_R2_TYPE=s3
export RCLONE_CONFIG_R2_PROVIDER=Cloudflare
export RCLONE_CONFIG_R2_ACCESS_KEY_ID="$R2_ACCESS_KEY_ID"
export RCLONE_CONFIG_R2_SECRET_ACCESS_KEY="$R2_SECRET_ACCESS_KEY"
export RCLONE_CONFIG_R2_ENDPOINT="$ENDPOINT"
export RCLONE_CONFIG_R2_REGION=auto
export RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
export RCLONE_CONFIG_R2_ACL=private

REMOTE="r2:${R2_BUCKET}"
[ -n "$PREFIX" ] && REMOTE="${REMOTE}/${PREFIX}"

# Atomic replace, and only when the rules actually change. Rewriting the same
# bytes still bumps mtime; a partial write would change the filters hash and
# force a bisync --resync.
write_filters() {
  local tmp
  tmp=$(mktemp "$WORKDIR/filters.XXXXXX")
  cat > "$tmp" <<'EOF'
- .git/**
- node_modules/**
- .obsidian/**
- .trash/**
- _remotely-save-metadata-on-remote.json
- .DS_Store
- *.tmp
EOF
  if [ -f "$FILTERS_FILE" ] && cmp -s "$tmp" "$FILTERS_FILE"; then
    rm -f "$tmp"
  else
    mv "$tmp" "$FILTERS_FILE"
  fi
}
write_filters

# --- git snapshots ----------------------------------------------------------

GIT=(git -C "$WORKSPACE_DIR" -c user.name="openclaw-r2-sync" -c user.email="r2-sync@localhost")

git_init() {
  if [ ! -d "$WORKSPACE_DIR/.git" ]; then
    "${GIT[@]}" init -q -b main >/dev/null 2>&1 || "${GIT[@]}" init -q >/dev/null 2>&1
    log "initialised git repo in $WORKSPACE_DIR"
  fi
  # Local-only ignores: kept out of the synced tree.
  mkdir -p "$WORKSPACE_DIR/.git/info"
  for pat in 'node_modules/' '*.tmp' '.obsidian/' '.trash/' '.DS_Store'; do
    grep -qxF "$pat" "$WORKSPACE_DIR/.git/info/exclude" 2>/dev/null \
      || echo "$pat" >> "$WORKSPACE_DIR/.git/info/exclude"
  done
  if [ -n "${R2_GIT_REMOTE:-}" ]; then
    if "${GIT[@]}" remote get-url r2backup >/dev/null 2>&1; then
      "${GIT[@]}" remote set-url r2backup "$R2_GIT_REMOTE"
    else
      "${GIT[@]}" remote add r2backup "$R2_GIT_REMOTE"
    fi
  fi
}

git_snapshot() {
  local label="$1"
  [ "$SNAPSHOTS" = "true" ] || return 0
  "${GIT[@]}" add -A >/dev/null 2>&1 || return 0
  if ! "${GIT[@]}" diff --cached --quiet 2>/dev/null; then
    if "${GIT[@]}" commit -q -m "$label $(date -u +%FT%TZ)" >/dev/null 2>&1; then
      log "git snapshot: $label"
      if [ -n "${R2_GIT_REMOTE:-}" ]; then
        # Output suppressed: the remote URL may contain a token.
        "${GIT[@]}" push -q r2backup HEAD:refs/heads/main >/dev/null 2>&1 \
          || log "git push to R2_GIT_REMOTE failed (will retry on next snapshot)"
      fi
    fi
  fi
  "${GIT[@]}" gc --auto -q >/dev/null 2>&1 || true
}

# --- bisync -----------------------------------------------------------------

BISYNC_COMMON=(
  --workdir "$WORKDIR"
  --filters-file "$FILTERS_FILE"
  --conflict-resolve newer
  --conflict-loser num
  --resilient
  --recover
  --max-lock 10m
  --max-delete 25
  --create-empty-src-dirs
  --fast-list
)

# Lock body is either a bare PID (briefly, at create) or JSON renewed by
# rclone: {"PID":"123",...}. Default locks never expire, so a killed bisync
# blocks every later run until the file is removed.
lock_pid() {
  local file="$1" pid
  pid=$(sed -n 's/.*"PID":"\([0-9][0-9]*\)".*/\1/p' "$file" 2>/dev/null | tail -n 1)
  if [ -z "$pid" ] && grep -qxE '[0-9]+' "$file" 2>/dev/null; then
    pid=$(tr -cd '0-9' < "$file")
  fi
  printf '%s' "$pid"
}

# Drop a lock whose rclone is gone. A live bisync keeps it.
# Returns 1 when a bisync is still running.
release_stale_lock() {
  local lock pid args locks=()
  shopt -s nullglob
  locks=("$WORKDIR"/*.lck)
  shopt -u nullglob
  for lock in "${locks[@]}"; do
    pid=$(lock_pid "$lock")
    args=""
    if [ -n "$pid" ]; then
      args=$(ps -p "$pid" -o args= 2>/dev/null || true)
    fi
    case "$args" in
      *rclone*)
        case "$args" in
          *"<defunct>"*) ;;
          *)
            log "bisync still running (pid $pid); leaving $(basename "$lock")"
            return 1
            ;;
        esac
        ;;
    esac
    log "removing stale bisync lock $(basename "$lock")"
    rm -f "$lock"
  done
  return 0
}

# One watchdog per volume. A second `r2-sync --resync` asks the running
# process to merge on its next cycle instead of starting another bisync.
claim_singleton() {
  local old args
  if [ -f "$PIDFILE" ]; then
    old=$(tr -cd '0-9' < "$PIDFILE")
    args=""
    if [ -n "$old" ] && [ "$old" != "$$" ]; then
      args=$(ps -p "$old" -o args= 2>/dev/null || true)
    fi
    case "$args" in
      *bin/r2-sync*|r2-sync|r2-sync\ *)
        if [ "$FORCE_RESYNC" -eq 1 ]; then
          touch "$RESYNC_REQUEST"
          log "resync requested; running r2-sync (pid $old) will do it"
        else
          log "r2-sync already running (pid $old); exiting"
        fi
        exit 0
        ;;
    esac
  fi
  echo $$ > "$PIDFILE"
  trap 'rm -f "$PIDFILE"' EXIT
}

have_listings() {
  ls "$WORKDIR"/*.lst >/dev/null 2>&1
}

run_bisync() {
  local mode="${1:-normal}" out rc
  if ! release_stale_lock; then
    return 2
  fi
  if [ "$mode" = "resync" ]; then
    log "running resync (merging local and R2, newest wins)"
    out=$(rclone bisync "$WORKSPACE_DIR" "$REMOTE" "${BISYNC_COMMON[@]}" --resync --resync-mode newer 2>&1)
    rc=$?
  else
    out=$(rclone bisync "$WORKSPACE_DIR" "$REMOTE" "${BISYNC_COMMON[@]}" 2>&1)
    rc=$?
  fi
  if [ $rc -ne 0 ]; then
    log "bisync exited $rc: $(echo "$out" | tail -n 8 | tr '\n' ' ')"
  fi
  return $rc
}

sync_cycle() {
  if [ -e "$PAUSE_FLAG" ]; then
    log "paused ($PAUSE_FLAG exists); skipping"
    return 0
  fi
  if [ -e "$RESYNC_REQUEST" ]; then
    rm -f "$RESYNC_REQUEST"
    FORCE_RESYNC=1
    log "resync requested"
  fi

  git_snapshot "pre-sync"

  local rc=0
  if [ "$FORCE_RESYNC" -eq 1 ] || ! have_listings; then
    run_bisync resync || rc=$?
    # Keep the request if another bisync still holds the lock.
    if [ "$rc" -ne 2 ]; then
      FORCE_RESYNC=0
    fi
  else
    run_bisync normal || rc=$?
    # 7 = critical error requiring --resync (lost state, filter change, ...)
    if [ $rc -eq 7 ]; then
      run_bisync resync || rc=$?
    fi
  fi
  # 2 = another bisync still holds the lock; try again next cycle.
  if [ $rc -eq 2 ]; then
    return 0
  fi

  git_snapshot "post-sync"
}

# --- watchdog ---------------------------------------------------------------

STOP=0
WAIT_PID=""
WATCH=1
command -v inotifywait >/dev/null 2>&1 || WATCH=0

on_stop() {
  STOP=1
  [ -n "$WAIT_PID" ] && kill "$WAIT_PID" 2>/dev/null
}
trap on_stop TERM INT

# Run a command in the background and wait for it, so a TERM during the wait
# interrupts us immediately instead of after the full delay.
wait_for() {
  "$@" &
  WAIT_PID=$!
  wait "$WAIT_PID" 2>/dev/null
  local rc=$?
  WAIT_PID=""
  return $rc
}

watch_workspace() {
  inotifywait -r -qq -t "$INTERVAL" \
    -e modify,create,delete,move,attrib \
    --exclude '(^|/)(\.git|node_modules|__pycache__|\.obsidian|\.trash)/' \
    "$WORKSPACE_DIR"
}

# Block until it's time to sync again: as soon as the workspace changes, or
# after INTERVAL so changes made on the R2 side still get pulled in.
wait_for_next_sync() {
  if [ "$WATCH" -eq 0 ]; then
    wait_for sleep "$INTERVAL"
    return 0
  fi

  wait_for watch_workspace
  # 0 = change seen, 1 = inotify unusable, 2 = timed out, >128 = signalled.
  case $? in
    0)
      [ "$STOP" -eq 1 ] && return 0
      wait_for sleep "$DEBOUNCE"
      ;;
    1)
      WATCH=0
      log "inotifywait failed; falling back to polling every ${INTERVAL}s"
      wait_for sleep "$INTERVAL"
      ;;
  esac
}

claim_singleton
git_init
if [ "$WATCH" -eq 1 ]; then
  log "starting: remote=$REMOTE watching=$WORKSPACE_DIR debounce=${DEBOUNCE}s max-interval=${INTERVAL}s"
else
  log "starting: remote=$REMOTE interval=${INTERVAL}s workspace=$WORKSPACE_DIR (inotifywait not found)"
fi

while [ "$STOP" -eq 0 ]; do
  rotate_log
  sync_cycle
  [ "$STOP" -eq 1 ] && break
  wait_for_next_sync
done

log "stop requested; running final sync"
# Ignore further signals so the final sync can finish.
trap '' TERM INT
sync_cycle
log "exiting"
