{
  "display_information": {
      "name": "Serenity",
      "description": "Slack connector for OpenClaw"
  },
  "features": {
      "app_home": {
          "home_tab_enabled": true,
          "messages_tab_enabled": true,
          "messages_tab_read_only_enabled": false,
          "agent_tasks_enabled": true
      },
      "bot_user": {
          "display_name": "Serenity",
          "always_online": true
      },
      "slash_commands": [
          {
              "command": "/openclaw",
              "description": "Send a message to OpenClaw",
              "should_escape": false
          },
          {
              "command": "/think",
              "description": "Set the thinking level or clear the session override",
              "usage_hint": "<level|default>",
              "should_escape": false
          },
          {
              "command": "/skill",
              "description": "Run a skill by name",
              "usage_hint": "<name> [input]",
              "should_escape": false
          },
          {
              "command": "/model",
              "description": "Show or set the model",
              "usage_hint": "[name|default|list|status] [-s|-a|-g]",
              "should_escape": false
          },
          {
              "command": "/agentstatus",
              "description": "Show runtime status, including provider usage/quota when available",
              "should_escape": false
          },
          {
              "command": "/new",
              "description": "Archive the current session and start a fresh one",
              "usage_hint": "[model]",
              "should_escape": false
          },
          {
              "command": "/compact",
              "description": "Compact the session context",
              "usage_hint": "[instructions]",
              "should_escape": false
          },
          {
              "command": "/reason",
              "description": "Toggle reasoning visibility",
              "usage_hint": "[on|off|stream]",
              "should_escape": false
          },
          {
              "command": "/followup",
              "description": "Run a message as a new turn, queued behind current work",
              "usage_hint": "<message>",
              "should_escape": false
          },
          {
              "command": "/steer",
              "description": "Inject guidance into the active run",
              "usage_hint": "<message>",
              "should_escape": false
          },
          {
              "command": "/fast",
              "description": "Show, set, or clear fast mode",
              "usage_hint": "[status|auto|on|off|ultrafast|default]",
              "should_escape": false
          },
          {
              "command": "/goal",
              "description": "Manage this session's durable goal",
              "usage_hint": "[status|start|edit|pause|resume|complete|block|clear]",
              "should_escape": false
          },
          {
              "command": "/btw",
              "description": "Ask a side question without changing session context",
              "usage_hint": "<question>",
              "should_escape": false
          }
      ],
      "agent_view": {
          "agent_description": "OpenClaw connects Slack Agent View conversations to OpenClaw agents.",
          "suggested_prompts": [
              {
                  "title": "What can you do?",
                  "message": "What can you help me with?"
              },
              {
                  "title": "Summarize this channel",
                  "message": "Summarize the recent activity in this channel."
              },
              {
                  "title": "Draft a reply",
                  "message": "Help me draft a reply."
              }
          ]
      }
  },
  "oauth_config": {
      "scopes": {
          "bot": [
              "app_mentions:read",
              "assistant:write",
              "channels:history",
              "channels:read",
              "chat:write",
              "commands",
              "emoji:read",
              "files:read",
              "files:write",
              "groups:history",
              "groups:read",
              "im:history",
              "im:read",
              "im:write",
              "mpim:history",
              "mpim:read",
              "mpim:write",
              "pins:read",
              "pins:write",
              "reactions:read",
              "reactions:write",
              "usergroups:read",
              "users:read"
          ],
          "bot_optional": [
              "emoji:read"
          ]
      },
      "pkce_enabled": false
  },
  "settings": {
      "event_subscriptions": {
          "bot_events": [
              "app_home_opened",
              "app_mention",
              "app_context_changed",
              "agent_session_stopped",
              "agent_session_title_changed",
              "channel_rename",
              "member_joined_channel",
              "member_left_channel",
              "message.channels",
              "message.groups",
              "message.im",
              "message.mpim",
              "pin_added",
              "pin_removed",
              "reaction_added",
              "reaction_removed"
          ]
      },
      "interactivity": {
          "is_enabled": true
      },
      "org_deploy_enabled": false,
      "socket_mode_enabled": true,
      "is_mcp_enabled": false,
      "token_rotation_enabled": false,
      "app_level_token_rotation_enabled": false
  }
}
