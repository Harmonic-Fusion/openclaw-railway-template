alias resource='source ~/.zshrc'
alias allenv='env | sort | less'
alias chmodinfo='echo -e "chmod information:\n 7 = full (111) \n 6 = read/write (110)\n 5 = read/exec (101)\n 4 = read (100)\n 3 = write/exec (011)\n 2 = write (010)\n 1 = exec (001)\n 0 = none (000)\n \n SHELL$ chmod 754 foo.txt\n  ^= gives user (u) full, group (g) read/exec,  and  others (o) read only"'
alias lsl='ls -haltr'  # -halter  the -e is part of the -l
alias lss='ls -hsl'

mkcursor () {

    help="
Usage: mkcursor <directory>
Helper for \`mkdir -p <directory> && cursor <directory>\`
"
    help_decorator ${help} $@ && return
    # ------------------------------- #
    mkdir -p $1
    cursor $1
}


help_decorator () {
    # This decorator is meant to help simple functions with documentation
    # 
    # Example:
    # ```
    # hello () {
    #     help="
    # Usage: hello
    # Simple utility function
    # "
    #     help_decorator ${help} $@ && return
    #     echo "world"
    # }
    # ```
    # 
    # the help_decorator will return 1 if no help is called for otherwise
    # returns 0 and then causes the return function to be called exiting the 
    # function


    # get help text from first argument
    help_text=${1:-'Usage:...'}

    # skip first argument 
    shift

    # check for help string
    while getopts ':h' flag; do
    case "${flag}" in
        h)
            echo ${help_text}
            return 0
            ;;
        *)
            echo "Unknown flag: -${flag}"
            echo ${help_text}
            return 0
            ;;
    esac
    done
    return 1
}


dus () {
    help="
Usage: dus [files or dirs]
Helper for \` du -csh -- ... | sort -h\`
Defaults to all files in \$PWD including hidden; pass paths (@) to override.
"
    help_decorator ${help} $@ && return
    # ------------------------------- #
    if (( $# )); then
        _duspath=("$@")
    else
        # *(D) includes hidden files; still excludes . and ..
        setopt local_options null_glob
        _duspath=(*(D))
    fi
    echo "% du -csh -- ${_duspath[@]} | sort -h"
    du -csh -- "${_duspath[@]}" | sort -h
}


tarx () {
    help="
Usage: tarx FILE.tar.gz
Helper for \`tar -xvzf <file>\`
"
    help_decorator ${help} $@ && return
    # ------------------------------- #
    out="extracted__$1"
    mkdir $out
    mv $1 $out
    cd $out
    tar -xzvf $1
    cd ..
    mv $out/$1 .
    echo mv $out/* .
}


tarc () {
    help="
Usage: tarc <directory>
Helper for \`tar -czvf <dest> <src>\`
"
    help_decorator ${help} $@ && return
    # ------------------------------- #
    src=${1%/}
    dest=${src}.tar.gz
    tar -zcvf $dest $src
}


historycopy () {
    help="
Usage: historycopy [-n number]

    -n          number of recent history comands to copy
    -h          this help text

Copy recent history to clipboard"

    # based on https://google.github.io/styleguide/shellguide.html
    num_lines=1
    while getopts 'n:h' flag; do
    case "${flag}" in
        n) num_lines="${OPTARG}" ;;
        h)
            echo ${help}
            return 0 ;;
        *)
            echo ${help}
            return 1 ;;
    esac
    done

    history | tail -n ${num_lines} | python -c '
import sys
for line in sys.stdin:
    parts = line.split()
    sys.stdout.write(" ".join(parts[1:]) + "\n")
' | pbcopy
}

