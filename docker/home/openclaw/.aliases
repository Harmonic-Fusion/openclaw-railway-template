# --------------------------------------------------------------------------- #
# Git 
#----------------------------------------------------------------------------- #

alias grr='git reset HEAD~1'
alias gac='gitaddcommit'
alias gda='gitdiffadd'
alias gus='git restore --staged'
alias wip='git commit -am "WIP"'

unalias gcb || true
function gcb {
    git checkout -b $1 2> /dev/null || git checkout $1
}
function _complete_gcb {
    local cur prev opts
    git for-each-ref --format="%(refname:strip=2)" "refs/heads/$cur*" "refs/heads/$cur*/**"    
}
complete -F _complete_gcb gcb


unalias gb || true
function gb {
    if [[ "${@}" == "" ]]
    then
        git branch --sort=-committerdate | cat
    else
        git branch $@
    fi
}
